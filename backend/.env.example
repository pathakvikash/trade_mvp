# Copy to .env and fill in. Never commit .env.

# development | production | test (required)
NODE_ENV=development
# HTTP port (default 4000)
PORT=4000
# Interface to bind. Default: 127.0.0.1 in development, 0.0.0.0 when NODE_ENV=production. Set only to override.
HOST=127.0.0.1
# Reverse-proxy hops to trust for the client IP (rate limits): 0/false (default, no proxy), a hop count (Render/Railway/Fly: 1),
# or true (trust every X-Forwarded-For entry: spoofable, avoid). Leave 0 when clients connect directly.
TRUST_PROXY=0
# Write error.log/combined.log in the cwd. Default: true outside production, false in production (console JSON only).
# LOG_TO_FILES=
# MongoDB connection string (required)
MONGO_URI=mongodb://127.0.0.1:27017/crypto_trading_mvp
# JWT signing secret (required, >= 32 chars, placeholders are rejected at startup). Generate one and paste it here: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Comma-separated browser origins allowed by CORS and Socket.IO (default in dev: http://localhost:3000,http://localhost:3001).
# REQUIRED in production, exact origins only, no wildcard (startup fails otherwise).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Seed a demo guest user (guest@cryptozen.com, role user) on startup. Off unless exactly "true". Never seeds an admin.
# Refused in production: NODE_ENV=production with SEED_DEMO_USERS=true fails startup.
SEED_DEMO_USERS=false
# Password for the demo guest, >= 12 chars. If it is shorter or missing, seeding is skipped with a warning.
# An existing guest gets this password and role=user on every start while seeding is on.
# DEMO_GUEST_PASSWORD=

# Google OAuth 2.0 Web client ID for "Continue with Google" (public, not a secret). Empty = the button stays disabled.
# GOOGLE_CLIENT_ID=

# Anthropic credentials for the AI copilot: either one enables it (optional; production logs a warning and runs with AI off if both are missing)
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# Model id for the AI copilot (default claude-opus-5-5)
# AI_MODEL=
# Process-wide ceiling on billed AI calls per hour (optional; service default applies when empty)
# AI_MAX_CALLS_PER_HOUR=

# Binance USDS-M futures REST / WebSocket base URLs (defaults: https://fapi.binance.com, wss://fstream.binance.com)
# BINANCE_FUTURES_REST=
# BINANCE_FUTURES_WS=
# Spot market poll interval in ms (optional; service default applies when empty)
# MARKET_POLL_INTERVAL_MS=
