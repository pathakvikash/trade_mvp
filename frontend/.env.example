# Copy to .env.local (dev) or set in Vercel project settings (build-time; CRA inlines at build).

# Base URL of the backend API AND the Socket.IO server (no trailing slash).
# Dev: http://localhost:4000   Vercel: https://your-backend.example.com
# Empty = same origin for API calls (needs a proxy/rewrite); sockets then fall back to <page host>:4000.
REACT_APP_API_URL=http://localhost:4000

# Note: the Google client id is served by the backend (GOOGLE_CLIENT_ID in backend/.env), not set here.
